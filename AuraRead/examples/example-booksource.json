[
  {
    "bookSourceName": "示例书源（把地址和规则换成你自己站的）",
    "bookSourceUrl": "https://example.com",
    "bookSourceGroup": "示例",
    "bookSourceType": 0,
    "enabled": true,
    "searchUrl": "https://example.com/search?q={{key}}&page={{page}}",
    "header": "{\"User-Agent\":\"Mozilla/5.0 (iPhone; CPU iPhone OS 17_5 like Mac OS X)\"}",
    "ruleSearch": {
      "bookList": "class.book-item || class.result-item",
      "name": "class.title@text",
      "author": "class.author@text",
      "kind": "class.cate@text",
      "intro": "class.intro@text",
      "lastChapter": "class.latest@text",
      "coverUrl": "tag.img@src",
      "bookUrl": "tag.a@href"
    },
    "ruleBookInfo": {
      "name": "id.bookName@text",
      "author": "id.bookAuthor@text",
      "intro": "id.bookIntro@text",
      "coverUrl": "class.cover@tag.img@src",
      "tocUrl": "class.read-btn@href",
      "lastChapter": "class.last-chapter@text"
    },
    "ruleToc": {
      "chapterList": "id.chapterList@tag.a",
      "chapterName": "text",
      "chapterUrl": "href"
    },
    "ruleContent": {
      "content": "id.content@html",
      "nextContentUrl": "class.next@href"
    }
  }
]
